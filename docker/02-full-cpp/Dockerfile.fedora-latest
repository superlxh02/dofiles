FROM fedora:latest

LABEL org.opencontainers.image.title="full-cpp-fedora-latest" \
      org.opencontainers.image.description="Complete GNU/LLVM C++ toolchain and package-manager stack on the latest stable Fedora"

ARG BAZELISK_VERSION=v1.29.0
ARG TARGETARCH
ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DISABLE_METRICS=1

RUN dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        autoconf automake bash-completion bison ccache ca-certificates \
        clang clang-tools-extra cmake compiler-rt cppcheck curl file flex \
        gcc gcc-c++ gcc-gfortran gdb git jq \
        bcc-tools bpftrace bpftool dwarves elfutils-libelf-devel \
        libcxx-devel libcxxabi-devel libbpf-devel libomp-devel libtool lld lldb llvm make meson mold \
        ninja-build pkgconf-pkg-config python3 python3-pip \
        perf strace tar tcpdump unzip valgrind wget wrk xz zip \
    && dnf clean all \
    && rm -rf /var/cache/dnf /tmp/* \
    && command -v clangd \
    && command -v clang-format

RUN python3 -m venv /opt/conan \
    && /opt/conan/bin/pip install --no-cache-dir --upgrade pip conan

RUN git clone --depth 1 https://github.com/microsoft/vcpkg.git "${VCPKG_ROOT}" \
    && "${VCPKG_ROOT}/bootstrap-vcpkg.sh" -disableMetrics \
    && rm -rf "${VCPKG_ROOT}/.git"

RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in amd64|arm64) ;; *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-${arch}" -o /usr/local/bin/bazel; \
    chmod +x /usr/local/bin/bazel; \
    ln -s /usr/local/bin/bazel /usr/local/bin/bazelisk

RUN curl -fsSL https://xmake.io/shget.text | bash

ENV PATH="/opt/conan/bin:${VCPKG_ROOT}:/root/.local/bin:${PATH}" \
    CMAKE_TOOLCHAIN_FILE="${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"

WORKDIR /workspace
CMD ["/bin/bash"]

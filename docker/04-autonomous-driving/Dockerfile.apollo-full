ARG APOLLO_DEV_IMAGE=apolloauto/apollo:dev-x86_64-18.04-20240620_1444
ARG APOLLO_PLATFORM=linux/amd64
FROM --platform=${APOLLO_PLATFORM} ${APOLLO_DEV_IMAGE}

LABEL org.opencontainers.image.title="apollo-full-dev" \
      org.opencontainers.image.description="Apollo full development environment based on the official Apollo image"

RUN apt-get update \
    && apt-get install -y --no-install-recommends clangd clang-format \
    && rm -rf /var/lib/apt/lists/* \
    && command -v clangd \
    && command -v clang-format

ENV APOLLO_IN_DOCKER=true \
    APOLLO_ROOT_DIR=/apollo

WORKDIR /apollo
CMD ["/bin/bash"]
